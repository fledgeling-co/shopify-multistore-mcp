{
  "name": "shopherd",
  "version": "0.3.0",
  "description": "Shopherd: several Shopify stores in one AI assistant. Ask once, every store answers, each answer names its store. Signs in through Shopify's own CLI; no keys stored.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "shopify",
    "shopify-cli",
    "multi-store",
    "claude",
    "cursor",
    "codex",
    "agency"
  ],
  "homepage": "https://fledgeling-co.github.io/shopherd/",
  "bugs": {
    "url": "https://github.com/fledgeling-co/shopherd/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fledgeling-co/shopherd.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "shopherd": "bin/shopherd.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/shopherd.js",
    "test": "node --test test/*.test.js",
    "eval": "node evals/run.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
